# Use the computer's LAN IPv4 address when testing from a physical phone.
EXPO_PUBLIC_AI_API_URL=http://192.168.1.100:8000
# StepAble API used by reports and uploaded photos. Defaults to the URL above.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Optional custom map tiles. Leave blank to use OpenStreetMap tiles.
# Example: MapTiler raster tiles (requires your own key)
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_API_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Geoapify Places API for automatic place icons in Bangkok and Chon Buri.
# EXPO_PUBLIC_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
