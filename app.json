{
  "expo": {
    "name": "st-fe",
    "slug": "st-fe",
    "scheme": "st-fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "th",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StepAble uses your location while the app is open to show maps, weather, and walking routes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "StepAble uses the camera to analyze walkways and attach photos to issue reports.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StepAble accesses photos when you choose an image to attach to a report."
        }
      ],
      "expo-font"
    ],
    "locales": {
      "th": "./src/i18n/native/th.json",
      "en": "./src/i18n/native/en.json"
    }
  }
}
